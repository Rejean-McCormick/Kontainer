{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kristal:container:manifest:1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "kristal.container-manifest/1"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ]
      },
      "maxItems": 10000
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "public_key": {
          "type": "string",
          "minLength": 44,
          "maxLength": 44,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "value": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "required": [
        "algorithm",
        "public_key",
        "value"
      ]
    }
  },
  "required": [
    "format",
    "files"
  ]
}
